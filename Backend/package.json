{
  "name": "tesoreria-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST del control de pagos de Tesorería (Fastify + Prisma + SQLite)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx seed/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx seed/seed.ts",
    "importar": "tsx src/cli/importar.ts",
    "catalogo": "tsx src/cli/catalogo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
