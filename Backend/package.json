{
  "name": "tesoreria-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST del control de pagos de Tesorería (Fastify + Prisma + MySQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:verificar": "tsx scripts/verificar-conexion.ts",
    "db:verificar-datos": "tsx src/cli/verificar-datos.ts",
    "db:migrar:crear": "prisma migrate dev",
    "db:migrar": "prisma migrate deploy",
    "db:estado": "prisma migrate status",
    "db:seed": "tsx seed/seed.ts",
    "db:setup": "prisma generate && prisma migrate deploy && tsx seed/seed.ts",
    "db:preparar-test": "tsx scripts/preparar-test.ts",
    "importar": "tsx src/cli/importar.ts",
    "catalogo": "tsx src/cli/catalogo.ts",
    "reimportar": "tsx src/cli/reimportar.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
