# Copie este archivo a .env y ajuste los valores. Nunca versione el .env.
PORT=3001
# MySQL. Formato: mysql://USUARIO:CLAVE@127.0.0.1:3306/NOMBRE_BASE (siempre 127.0.0.1, no localhost).
# Base de desarrollo (la usa la API y la importación).
DATABASE_URL=
# Base de pruebas automáticas: cada corrida la borra por completo. El nombre debe terminar en _test.
TEST_DATABASE_URL=
# Base "sombra" que Prisma usa solo al crear migraciones (se crea y se borra sola).
SHADOW_DATABASE_URL=
# Orígenes permitidos por CORS (el Frontend), separados por coma.
CORS_ORIGINS=http://localhost:3000
# Carpeta con los estados de cuenta (solo lectura). Se usa desde el Hito 2.
STATEMENTS_ROOT=
# Tabla de pagos frecuentes (.xlsx, solo lectura) con el catálogo de obligaciones. Hito 3.
CATALOGO_FILE=
# Carpeta donde se guardan los borradores de correo (.eml / HTML). Hito 5.
MAIL_DRAFTS_DIR=./borradores
# SMTP: vacío en el piloto (no se envía nada real).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
