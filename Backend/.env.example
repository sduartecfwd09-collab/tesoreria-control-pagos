# Copie este archivo a .env y ajuste los valores.
PORT=3001
# SQLite en el piloto (ruta relativa a la carpeta Backend). Portable a PostgreSQL / SQL Server.
DATABASE_URL="file:./dev.db"
# Orígenes permitidos por CORS (el Frontend), separados por coma.
CORS_ORIGINS=http://localhost:3000
# Carpeta con los estados de cuenta (solo lectura). Se usa desde el Hito 2.
STATEMENTS_ROOT=
# Carpeta donde se guardan los borradores de correo (.eml / HTML). Hito 5.
MAIL_DRAFTS_DIR=./borradores
# SMTP: vacío en el piloto (no se envía nada real).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
